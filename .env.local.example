# eBird API key – request one at https://ebird.org/api/keygen
EBIRD_API_KEY=

# Geoapify API key – create one at https://myprojects.geoapify.com
# When set, geocoding (/api/geocode) and nearby locations (/api/locations) are
# served by Geoapify; the public Nominatim/Overpass services remain as
# automatic fallbacks. Optional — the app works without it.
GEOAPIFY_API_KEY=

# Optional: comma-separated Overpass interpreter URLs, tried in order.
# Defaults to the public instances (overpass-api.de, then kumi.systems).
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter
