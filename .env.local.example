# eBird API key – request one at https://ebird.org/api/keygen
EBIRD_API_KEY=

# Geoapify API key – create one at https://myprojects.geoapify.com
# Required for nearby locations (/api/locations, /api/geometry); geocoding
# (/api/geocode) also uses Geoapify when set, with public Nominatim as the
# automatic fallback.
GEOAPIFY_API_KEY=

# Optional: Google Search Console verification token (the content value of the
# meta verification tag). When set, a google-site-verification meta tag is emitted.
GOOGLE_SITE_VERIFICATION=

# Optional: where the bird-sighting archive (JSON) is stored. eBird only serves
# 30 days of live data, so longer time ranges read from this accumulating file.
# Default: Vercel Blob when BLOB_READ_WRITE_TOKEN is set (durable across
# deployments), otherwise .data/sightings-archive.json next to the app, with a
# fallback to the OS temp directory on read-only filesystems. Force a backend
# with SIGHTINGS_ARCHIVE_BACKEND=file or =vercel-blob.
SIGHTINGS_ARCHIVE_BACKEND=
SIGHTINGS_ARCHIVE_PATH=
