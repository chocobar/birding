# eBird API key – request one at https://ebird.org/api/keygen
EBIRD_API_KEY=

# Xeno-canto API key – free with any xeno-canto.org account with a verified
# email (look yours up at https://xeno-canto.org/account). Used for the
# bird-card audio player's species → recording lookups (server-side only).
# Optional: when absent, lookups fall back to Xeno-canto's public explore
# pages, which need no key.
XENO_CANTO_API_KEY=

# Geoapify API key – create one at https://myprojects.geoapify.com
# Required for nearby locations (/api/locations, /api/geometry); geocoding
# (/api/geocode) also uses Geoapify when set, with public Nominatim as the
# automatic fallback.
GEOAPIFY_API_KEY=

# Optional: Overpass API endpoints for trail discovery (named walking-route
# relations), comma-separated full interpreter URLs. Defaults to the public
# instances (overpass-api.de, overpass.kumi.systems); point the first entry
# at a private instance for production reliability. An Overpass outage hides
# trails from the list but never fails it.
# OVERPASS_ENDPOINTS=https://overpass.example.com/api/interpreter

# Optional: Google Search Console verification token (the content value of the
# meta verification tag). When set, a google-site-verification meta tag is emitted.
GOOGLE_SITE_VERIFICATION=

# Optional: where the bird-sighting archive (JSON) is stored. eBird only serves
# 30 days of live data, so longer time ranges read from this accumulating file.
# Default: the Helix web-service data dir (HELIX_WEB_SERVICE_DATA_DIR, typically
# /data) when running as a Helix web service — a persistent volume that survives
# redeploys — otherwise .data/sightings-archive.json next to the app, then the
# OS temp dir. Set this to pin a custom location.
SIGHTINGS_ARCHIVE_PATH=

# Optional: set to 1 to turn analytics off entirely — no tracker is rendered.
ANALYTICS_DISABLED=

# ---------------------------------------------------------------------------
# Analytics provider (optional)
#
# The site has no analytics store of its own: when ONE of the credential
# variables below is set, a lightweight tracker forwards pageviews and
# engagement events (searches, map opens, audio plays, clicks…) to that
# provider. With no credential set, no tracker is rendered at all. The
# provider script + credential appear in the public page source; they are
# read when the site is built, so set them before `npm run build` / deploy.
# ---------------------------------------------------------------------------

# Umami (https://umami.is — free cloud tier, or self-hosted). Copy the
# website id from your Umami dashboard (Settings → Websites). The script src
# defaults to Umami Cloud (https://cloud.umami.is/script.js); for a
# self-hosted instance also set UMAMI_SCRIPT_URL to your instance's /script.js.
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=

# Plausible (https://plausible.io) — the site domain configured in Plausible.
# PLAUSIBLE_DOMAIN=

# PostHog (https://posthog.com — free tier: 1M events/month, autocaptured
# clicks, heatmaps). EU cloud ingest host by default; set POSTHOG_API_HOST
# to https://us.i.posthog.com for the US cloud or your self-hosted URL.
# POSTHOG_API_KEY=
# POSTHOG_API_HOST=

# Google Analytics 4 — measurement id from the GA4 admin panel.
# GA4_MEASUREMENT_ID=

# Optional: force a provider instead of auto-detecting from credentials:
# umami | plausible | posthog | ga4
# ANALYTICS_PROVIDER=
