# eBird API key – request one at https://ebird.org/api/keygen
EBIRD_API_KEY=

# Xeno-canto API key – free with any xeno-canto.org account with a verified
# email (look yours up at https://xeno-canto.org/account). Used for the
# bird-card audio player's species → recording lookups (server-side only).
# Optional: when absent, lookups fall back to Xeno-canto's public explore
# pages, which need no key.
XENO_CANTO_API_KEY=

# Geoapify API key – create one at https://myprojects.geoapify.com
# Required for nearby locations (/api/locations, /api/geometry); geocoding
# (/api/geocode) also uses Geoapify when set, with public Nominatim as the
# automatic fallback.
GEOAPIFY_API_KEY=

# Optional: Overpass API endpoints for trail discovery (named walking-route
# relations), comma-separated full interpreter URLs. Defaults to the public
# instances (overpass-api.de, overpass.kumi.systems); point the first entry
# at a private instance for production reliability. An Overpass outage hides
# trails from the list but never fails it.
# OVERPASS_ENDPOINTS=https://overpass.example.com/api/interpreter

# Optional: Google Search Console verification token (the content value of the
# meta verification tag). When set, a google-site-verification meta tag is emitted.
GOOGLE_SITE_VERIFICATION=
